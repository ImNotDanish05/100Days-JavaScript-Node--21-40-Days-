<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chat with Llama AI</title>
    <style>
        body { font-family: Arial, sans-serif; }
        .container { max-width: 600px; margin: 50px auto; text-align: center; }
        textarea { width: 100%; height: 100px; }
        button { margin-top: 10px; padding: 10px 20px; }
        .response { margin-top: 20px; background: #f0f0f0; padding: 10px; border-radius: 8px; }
    </style>
</head>
<body>
    <div class="container">
        <h1>Chat with Llama AI</h1>
        <textarea id="input" placeholder="Ask something to Llama..."></textarea><br>
        <button onclick="sendToLlama()">Send</button>
        <div class="response" id="response"></div>
    </div>

    <script>
        async function sendToLlama() {
            const input = document.getElementById('input').value;
            const responseDiv = document.getElementById('response');
            
            const res = await fetch('/ask-ai', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ input })
            });
            
            const data = await res.text();
            responseDiv.textContent = data;
        }
    </script>
</body>
</html>
