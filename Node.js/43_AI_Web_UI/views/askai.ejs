<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI Danish05 xD</title>
    <link href="/style.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
</head>
<body class=".bg-secondaryy">
    
    <h1>Send Prompt to Your GF AI</h1>

      <div class="container-fluid">
        <div class="row">
          <!-- Sisi kiri untuk chat -->
          <div class="col-md-6 chat-section">
            <!-- Contoh chat -->
            <div class="chat-box">
    
            <% if (typeof response !== 'undefined') { %>
                <p>Pacar: <%= response %></p>
            <% } %>
            <% for( var i = 0 ; i < data.length ; i++ ) { %>
              <p>User: <%= data[i].prompt %> </p>
              <p>Pacar: <%= data[i].response %> </p>
            <% } %>
 
                <!-- Konten chat box lainnya -->
                <form action="/askai" method="POST" class="mt-auto w-100">
                    <div class="input-group mb-3 w-100">
                        <button class="input-group-text" type="submit">Submit</button>
                        <input type="text" class="form-control" placeholder="Input Text Here" id="prompt" name="prompt" required>
                    </div>
                </form>
            
            </div>
          </div>
      
          <!-- Sisi kanan untuk gambar anime -->
          <!-- https://via.placeholder.com/800x1000 -->
          <!-- /picture/TheGF.png -->
          <div class="col-md-6 anime-image">
            <div class="d-flex justify-content-center align-items-center full-height">
              <img src="/picture/TheGF.png" alt="Anime Image" style="width: 100%; height: auto;">
            </div>
          </div>
        </div>
      </div>
      <script src="chatupdate.js"></script>
</body>
</html>
