<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Upload File SFW</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css">
</head>
<body>
    <div class="container mt-5">
        <h1>Upload File SFW</h1>
        <div class="input-group mb-3">
            <input type="file" class="form-control" id="inputGroupFile02" accept=".jpg,.jpeg,.png,.gif,.pdf,.docx">
            <label class="input-group-text" for="inputGroupFile02" id="fileLabel">Upload</label>
        </div>
        <div id="message" class="text-danger"></div>
    </div>

    <script>
        const fileInput = document.getElementById('inputGroupFile02');
        const fileLabel = document.getElementById('fileLabel');
        const message = document.getElementById('message');

        fileInput.addEventListener('change', function() {
            const allowedExtensions = /(\.jpg|\.jpeg|\.png|\.gif|\.pdf|\.docx)$/i; // Ekstensi yang diizinkan
            if (fileInput.files.length === 0) {
                fileLabel.textContent = 'Upload'; // Teks saat tidak ada file
                message.textContent = '';
            } else {
                const fileName = fileInput.files[0].name;
                if (!allowedExtensions.exec(fileName)) {
                    message.textContent = 'File tidak valid! Hanya file SFW (gambar dan dokumen) yang diizinkan.';
                    fileInput.value = ''; // Reset input file
                    fileLabel.textContent = 'Upload'; // Reset label
                } else {
                    fileLabel.textContent = fileName; // Menampilkan nama file yang diupload
                    message.textContent = ''; // Kosongkan pesan error
                }
            }
        });
    </script>
</body>
</html>